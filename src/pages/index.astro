---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logoMunitrip from '../assets/logo-munitrip-1.png';
import SegmentContainer from '../components/SegmentContainer.astro';
import hero1 from '../assets/hero-1.webp';
import hero2 from '../assets/hero-2.webp';
---

<Layout title="Munitrip | Próximamente">
  <!-- 1. Fondo global del body en #f5f5f5 -->
  <main class="min-h-screen bg-[#f5f5f5] font-inter flex flex-col items-center">
    
    <!-- 2. Contenedor "Mobile-First" centrado con bordes laterales -->
    <div class="w-full max-w-md bg-white min-h-screen flex flex-col relative shadow-2xl border-x border-[#d1dbe8]">
      
      <!-- CABECERA (White Section) -->
      <header class="pt-10 pb-5 flex flex-col items-center bg-white">
        <!-- Logo Section -->
        <div class="w-24 h-24 flex items-center pb-3 justify-center">
          <Image 
            src={logoMunitrip}
            alt="Munitrip Logo" 
            class="w-full h-full object-contain"
          />
        </div>

        <!-- Títulos Principales -->
        <div class="text-center">
          <h1 class="text-[#1d3557] font-extrabold text-3xl tracking-tight leading-none">
            ¡Próximamente!
          </h1>
          <h2 class="text-[#4a5567] font-medium text-lg ">
            Algo <span class="font-bold text-[#1d3557]">grande</span> se está construyendo
          </h2>
        </div>
      </header>

      <!-- Banner Informativo (Contraste Oscuro) -->
      <div class="bg-[#1d3557] text-white shadow-sm text-center py-1.5 px-13 text-[11px] font-light w-full rounded-lg">
        <p class="leading-4">La plataforma que conecta turistas y habitantes con lo mejor de <span class="font-bold">Viotá Cundinamarca</span>.
          </p>
      </div>



      <!-- ESPACIO PARA SEGMENTOS FLEXIBLES -->
      <section class="bg-[#f]w-full overflow-hidden ">
        <SegmentContainer>
          <!-- Contenedor de desplazamiento con altura controlada -->

            
            <!-- SEGMENTO 1: Ajustado para ser más compacto -->
            <div class="min-w-full snap-center bg-white flex-shrink-0 flex flex-col">
              
              <!-- Títulos: Reducimos padding -->
              <!-- Títulos: Centrado garantizado -->
            <div class="w-full flex flex-col items-center text-center px-1 py-7">
              <h3 class="text-[#4d5670] font-extrabold text-[16px] -mb-1.5">
                Encuentra todo en un solo lugar 
              </h3>
              <h2 class="text-[#1c2120] font-extrabold text-[22px] leading-tight">
                Planifica, visita, descubre
              </h2>
            </div>

              <!-- Imagen Hero: Monte La MaMa -->
              <div class="relative w-full h-50 bg-gray-200 overflow-hidden">
                <Image 
                  src={hero1} 
                  alt="Monte La MaMa" 
                  class="w-full h-full object-cover"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
                
              </div>

              <div class="grid grid-cols-5 w-full py-5 px-1 bg-white">
                
                <!-- Alojamientos -->
                <div class="flex flex-col items-center justify-center w-full gap-1.5">
                  <svg id="Layer_1" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="w-[26px] h-[26px] text-[#1c2120]">
                    <path fill="currentColor" d="m12.41.012c-2.528-.146-4.932 1.084-6.294 3.204-.479.746-.507 1.665-.074 2.458.447.818 1.298 1.327 2.222 1.327.823 0 1.587-.417 2.096-1.145.505-.722 1.394-1.02 2.264-.762.618.185 1.128.709 1.299 1.338.172.632.051 1.281-.333 1.782-.382.5-.961.787-1.59.787h-2.5c-2.481 0-4.5 2.019-4.5 4.5v6c0 2.481 2.019 4.5 4.5 4.5h5c2.481 0 4.5-2.019 4.5-4.5v-12.249c0-3.849-2.895-7.029-6.59-7.24zm5.59 19.488c0 1.93-1.57 3.5-3.5 3.5h-5c-1.93 0-3.5-1.57-3.5-3.5v-6c0-1.93 1.57-3.5 3.5-3.5h2.5c.942 0 1.812-.43 2.384-1.179.574-.75.757-1.717.503-2.652-.263-.97-1.021-1.749-1.978-2.034-1.29-.386-2.613.067-3.369 1.147-.319.457-.785.718-1.277.718-.558 0-1.073-.309-1.345-.806-.255-.467-.241-1.004.038-1.438 1.169-1.817 3.243-2.861 5.396-2.747 3.167.181 5.647 2.923 5.647 6.242v12.248z"/>
                  </svg>
                  <span class="text-[9px] font-medium text-[#1c2120] text-center leading-tight">Alojamientos</span>
                </div>

                <!-- Restaurantes -->
                <div class="flex flex-col items-center justify-center w-full gap-1.5">
                  <svg id="Layer_1" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="w-[26px] h-[26px] text-[#1c2120]">
                    <path fill="currentColor" d="M12.787,11.92L.854,23.854c-.098,.098-.226,.146-.354,.146s-.256-.049-.354-.146c-.195-.195-.195-.512,0-.707L12.08,11.213c-1.541-1.897-1.43-4.698,.335-6.464L17.018,.146c.195-.195,.512-.195,.707,0s.195,.512,0,.707l-4.603,4.603c-1.374,1.375-1.484,3.543-.33,5.045l7.354-7.354c.195-.195,.512-.195,.707,0s.195,.512,0,.707l-7.354,7.354c1.502,1.155,3.67,1.044,5.045-.33l4.603-4.603c.195-.195,.512-.195,.707,0s.195,.512,0,.707l-4.603,4.603c-.942,.942-2.18,1.413-3.418,1.413-1.081,0-2.161-.359-3.046-1.078Zm-6.104,1.831c.093,.076,.205,.113,.316,.113,.145,0,.289-.062,.388-.184,.175-.213,.143-.529-.071-.704C2.498,9.035,1.001,3.586,1.001,2.048v-.367c0-.409,.249-.57,.397-.629,.218-.085,.568-.087,.832,.192l6.102,6.596c.188,.203,.503,.215,.707,.028,.203-.188,.215-.504,.028-.707L2.96,.56C2.456,.027,1.697-.146,1.028,.123,.394,.375,0,.972,0,1.683v.365c0,1.954,1.684,7.613,6.684,11.703Zm9.684,1.302c-.188-.204-.504-.216-.707-.028-.203,.188-.215,.504-.028,.707l1.085,1.173c-1.787-.228-3.472-.668-5.026-1.313-.256-.105-.547,.015-.654,.27-.106,.255,.015,.548,.27,.654,1.968,.817,4.133,1.32,6.436,1.498l5.388,5.825c.099,.107,.233,.161,.367,.161,.122,0,.243-.044,.339-.133,.203-.188,.215-.504,.028-.707l-7.5-8.108Z"/>
                  </svg>
                  <span class="text-[9px] font-medium text-[#1c2120] text-center leading-tight">Restaurantes</span>
                </div>

                <!-- Experiencias -->
                <div class="flex flex-col items-center justify-center w-full gap-1.5">
                  <svg id="Outline" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="w-[26px] h-[26px] text-[#1c2120]">
                    <path fill="currentColor" d="m16.5,0h-1.5c-.276,0-.5.224-.5.5,0,1.378-1.122,2.5-2.5,2.5s-2.5-1.122-2.5-2.5c0-.276-.224-.5-.5-.5h-1.5C5.019,0,3,2.019,3,4.5v15c0,2.481,2.019,4.5,4.5,4.5h1.5c.276,0,.5-.224,.5-.5,0-1.378,1.122-2.5,2.5-2.5s2.5,1.122,2.5,2.5c0,.276.224.5.5.5h1.5c2.481,0,4.5-2.019,4.5-4.5V4.5c0-2.481-2.019-4.5-4.5-4.5Zm3.5,19.5c0,1.93-1.57,3.5-3.5,3.5h-1.036c-.243-1.694-1.704-3-3.464-3s-3.221,1.306-3.464,3h-1.036c-1.93,0-3.5-1.57-3.5-3.5V4.5c0-1.93,1.57-3.5,3.5-3.5h1.036c.243,1.694,1.704,3,3.464,3s3.221-1.306,3.464-3h1.036c1.93,0,3.5,1.57,3.5,3.5v15Zm-13-3c0,.276-.224.5-.5.5h-1c-.276,0-.5-.224-.5-.5s.224-.5.5-.5h1c.276,0,.5.224.5.5Zm4,0c0,.276-.224.5-.5.5h-1c-.276,0-.5-.224-.5-.5s.224-.5.5-.5h1c.276,0,.5.224.5.5Zm4,0c0,.276-.224.5-.5.5h-1c-.276,0-.5-.224-.5-.5s.224-.5.5-.5h1c.276,0,.5.224.5.5Zm4,0c0,.276-.224.5-.5.5h-1c-.276,0-.5-.224-.5-.5s.224-.5.5-.5h1c.276,0,.5.224.5.5Z"/>
                  </svg>
                  <span class="text-[9px] font-medium text-[#1c2120] text-center leading-tight">Experiencias</span>
                </div>

                <!-- Tiendas -->
                <div class="flex flex-col items-center justify-center w-full gap-1.5">
                  <svg id="Layer_1" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="w-[26px] h-[26px] text-[#1c2120]">
                    <path fill="currentColor" d="M23.38,8.85c-.47-.54-1.16-.85-1.88-.85h-.56C20.44,3.48,16.6,0,12,0S3.56,3.48,3.06,8h-.56c-.72,0-1.41,.31-1.88,.85-.47,.54-.69,1.26-.6,1.98l1.12,8.4c.36,2.72,2.71,4.77,5.45,4.77h10.81c2.75,0,5.09-2.05,5.45-4.77l1.12-8.4c.09-.71-.12-1.44-.6-1.98ZM12,1c4.05,0,7.44,3.03,7.94,7H4.06c.49-3.97,3.88-7,7.94-7Zm10.99,9.7l-1.12,8.4c-.3,2.23-2.21,3.91-4.46,3.91H6.59c-2.25,0-4.16-1.68-4.46-3.91L1.01,10.7c-.06-.43,.07-.86,.36-1.19s.7-.51,1.13-.51H21.5c.43,0,.84,.19,1.13,.51s.42,.76,.36,1.19Z"/>
                  </svg>
                  <span class="text-[9px] font-medium text-[#1c2120] text-center leading-tight">Tiendas</span>
                </div>

                <!-- Rumba -->
                <div class="flex flex-col items-center justify-center w-full gap-1.5">
                  <svg id="Layer_1" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="w-[26px] h-[26px] text-[#1c2120]">
                    <path fill="currentColor" d="m17.993,0c-2.542,0-4.795,1.632-5.638,4H2.362c-.976,0-1.839.596-2.199,1.517-.347.886-.137,1.829.587,2.498l7.022,6.037c.501.456,1.104.725,1.728.821v8.127h-4c-.276,0-.5.224-.5.5s.224.5.5.5h9c.276,0,.5-.224,.5-.5s-.224-.5-.5-.5h-4v-8.126c.621-.095,1.221-.361,1.718-.813l3.122-2.685c.828.41,1.718.623,2.65.625h.003s.004,0,.007,0h.003c3.304-.005,5.99-2.695,5.99-6S21.302,0,17.993,0Zm-6.438,13.312c-.409.371-.786.565-1.556.565s-1.152-.198-1.565-.574L1.39,7.245c-.381-.352-.491-.862-.295-1.363.159-.407.586-.882,1.268-.882h15.275c.682,0,1.108.475,1.268.882.196.501.086,1.011-.308,1.375l-7.042,6.055Zm6.441-2.312c-.632,0-1.241-.12-1.818-.346l3.111-2.675c.684-.633.894-1.576.547-2.462-.36-.921-1.224-1.517-2.199-1.517h-4.217c.786-1.793,2.575-3,4.573-3,2.757,0,5,2.243,5,5s-2.241,4.998-4.996,5Z"/>
                  </svg>
                  <span class="text-[9px] font-medium text-[#1c2120] text-center leading-tight">Rumba</span>
                </div>

              </div>
            </div>

          <!-- SEGMENTO 2: Ajustado para evitar desbordamiento al aumentar tamaños -->
            <div class=" w-full box-border scrollbar-none snap-center bg-white flex-shrink-0 flex flex-col overflow-hidden">
            
            <!-- Títulos: Centrado garantizado con flex-col e items-center -->
            <div class="w-full flex flex-col items-center text-center px-1 py-7">
              <h3 class="text-[#4d5670] font-extrabold text-[16px] -mb-1.5">
                ¿Qué hacer en Viotá, Cundinamarca?
              </h3>
              <h2 class="text-[#1c2120] font-extrabold text-[22px] leading-tight">
                Tu próximo viaje empieza aquí
              </h2>
            </div>

            <!-- Imagen Hero: Monte La MaMa -->
            <div class="w-full h-50 bg-gray-200 overflow-hidden relative">
              <Image 
                src={hero2} 
                alt="Monte La MaMa" 
                class="w-full h-full object-cover"
              />
              <!-- Overlay para legibilidad del nombre del lugar -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
              <div class="absolute bottom-4 left-4 text-white text-left">
                <h2 class="text-[20px] font-extrabold leading-tight text-white">Monte La MaMa:</h2>
                <p class="text-[13px] font-medium opacity-90 text-white">Refugio en el corazón del bosque</p>
              </div>
            </div>

            <!-- Navegación de Categorías: no-scrollbar y flex-nowrap evitan que se rompa el contenedor -->
            <div class="flex justify-center scrollbar-none overflow-x-auto py-6 px-4 gap-6 items-center bg-white w-full"> <div class="flex items-center gap-2 text-[#4d5670] flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" id="Outline" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" class="w-5 h-5"><path d="M23.121,9.069,15.536,1.483a5.008,5.008,0,0,0-7.072,0L.879,9.069A2.978,2.978,0,0,0,0,11.19v9.817a3,3,0,0,0,3,3H21a3,3,0,0,0,3-3V11.19A2.978,2.978,0,0,0,23.121,9.069ZM15,22.007H9V18.073a3,3,0,0,1,6,0Zm7-1a1,1,0,0,1-1,1H17V18.073a5,5,0,0,0-10,0v3.934H3a1,1,0,0,1-1-1V11.19a1.008,1.008,0,0,1,.293-.707L9.878,2.9a3.008,3.008,0,0,1,4.244,0l7.585,7.586A1.008,1.008,0,0,1,22,11.19Z"/></svg>
                <span class="text-[13px] font-bold">Todo</span>
              </div>
              
              <div class="flex items-center gap-2 text-[#1c2120] flex-shrink-0 border-b-2 border-[#1c2120] pb-1">
                <svg xmlns="http://www.w3.org/2000/svg" id="Layer_1" data-name="Layer 1" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" class="w-5 h-5"><path d="M15.091,16C21.661,15.964,24,12.484,24,9.5a3.5,3.5,0,0,0-2.764-3.419c.136-.387.254-.742.333-1.011a3.887,3.887,0,0,0-.626-3.458A3.979,3.979,0,0,0,17.729,0H6.271A3.979,3.979,0,0,0,3.057,1.612,3.887,3.887,0,0,0,2.431,5.07c.079.269.2.624.333,1.011A3.5,3.5,0,0,0,0,9.5c0,2.984,2.339,6.464,8.909,6.5A5.06,5.06,0,0,1,9,16.921V20a1.883,1.883,0,0,1-2,2H6a1,1,0,0,0,0,2H18a1,1,0,0,0,0-2h-.992A1.885,1.885,0,0,1,15,20V16.92A5.058,5.058,0,0,1,15.091,16ZM20.5,8A1.5,1.5,0,0,1,22,9.5c0,2.034-1.609,4.2-6.036,4.47a4.847,4.847,0,0,1,.762-.821A15.132,15.132,0,0,0,20.453,7.99C20.469,7.991,20.483,8,20.5,8ZM2,9.5A1.5,1.5,0,0,1,3.5,8c.017,0,.031-.009.047-.01a15.132,15.132,0,0,0,3.727,5.159,4.847,4.847,0,0,1,.762.821C3.609,13.7,2,11.534,2,9.5ZM10.513,22A4.08,4.08,0,0,0,11,20V16.921a6.93,6.93,0,0,0-2.431-5.295A15.338,15.338,0,0,1,4.349,4.5a1.9,1.9,0,0,1,.31-1.694A1.994,1.994,0,0,1,6.271,2H17.729a1.994,1.994,0,0,1,1.612.81,1.9,1.9,0,0,1,.31,1.694,15.338,15.338,0,0,1-4.22,7.122A6.928,6.928,0,0,0,13,16.92V20a4.08,4.08,0,0,0,.487,2Z"/></svg>
                <span class="text-[13px] font-bold">Imperdibles</span>
              </div>

              <div class="flex items-center gap-2 text-[#4d5670] flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" id="Layer_1" data-name="Layer 1" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" class="w-5 h-5"><path d="m8,12h-2c-1.103,0-2,.897-2,2v2c0,1.103.897,2,2,2h2c1.103,0,2-.897,2-2v-2c0-1.103-.897-2-2-2Zm-2,4v-2h2v2s-2,0-2,0ZM19,2h-1v-1c0-.552-.447-1-1-1s-1,.448-1,1v1h-8v-1c0-.552-.447-1-1-1s-1,.448-1,1v1h-1C2.243,2,0,4.243,0,7v12c0,2.757,2.243,5,5,5h14c2.757,0,5-2.243,5-5V7c0-2.757-2.243-5-5-5Zm-14,2h14c1.654,0,3,1.346,3,3v1H2v-1c0-1.654,1.346-3,3-3Zm14,18H5c-1.654,0-3-1.346-3-3v-9h20v9c0,1.654-1.346,3-3,3Z"/></svg>
                <span class="text-[13px] font-bold">Eventos</span>
              </div>

              <div class="flex items-center gap-2 text-[#4d5670] flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" id="Layer_1" data-name="Layer 1" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" class="w-5 h-5"><path d="M19,4h-1.101c-.465-2.279-2.485-4-4.899-4h-2c-2.414,0-4.435,1.721-4.899,4h-1.101C2.243,4,0,6.243,0,9v10c0,2.757,2.243,5,5,5h14c2.757,0,5-2.243,5-5V9c0-2.757-2.243-5-5-5ZM11,2h2c1.304,0,2.415,.836,2.828,2h-7.656c.413-1.164,1.524-2,2.828-2Zm11,17c0,1.654-1.346,3-3,3h-1V9c0-.553-.447-1-1-1s-1,.447-1,1v13H8V9c0-.553-.448-1-1-1s-1,.447-1,1v13h-1c-1.654,0-3-1.346-3-3V9c0-1.654,1.346-3,3-3h14c1.654,0,3,1.346,3,3v10Z"/></svg>
                <span class="text-[13px] font-bold">Turismo</span>
              </div>
            </div>

          </div>
          
          <!-- SEGMENTO 3: Mantiene el tamaño exacto de los anteriores -->
          <div class="min-w-full snap-center bg-white flex-shrink-0 flex flex-col overflow-hidden backface-hidden transform-gpu" style="image-rendering: -webkit-optimize-contrast; -webkit-font-smoothing: antialiased;">
  
            <div class="w-full flex flex-col items-center shadow-lg text-center px-1 py-7 shadow-sm border-b-[2px] border-[#d1dbe8]">
              <h3 class="text-[#4d5670] font-extrabold text-[16px] -mb-1.5 antialiased">
                Los mejores restaurantes en Viotá
              </h3>
              <h2 class="text-[#1c2120] font-extrabold text-[22px] leading-tight antialiased">
                Encuentra tu lugar ideal
              </h2>
            </div>

            <div class="w-full h-full bg-[#f8fafc] flex items-center justify-center p-1">
              
              <div class="w-full max-w-[360px] shadow-sm bg-white border-[2px] border-[#d1dbe8] rounded-[32px] p-2 flex gap-4 shadow-sm transform-gpu">
                
                <div class="w-[45%] h-57 overflow-hidden rounded-[24px] flex-shrink-0">
                  <Image 
                    src={hero2} 
                    alt="Restaurante en Viotá" 
                    class="w-full h-full object-cover"
                  />
                </div>

                <div class="w-[55%] flex flex-col justify-between pr-5 py-1">
                  
                  <div class="antialiased">
                    <div class="flex items-center justify-end gap-1 pb-1 mt-1 mr-1">
                      <svg class="w-3.5 h-3.5 text-[#2e7d32]" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
