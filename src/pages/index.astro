<script>
  import { supabase } from '../lib/supabase';

  const form = document.querySelector('#newsletter-form') as HTMLFormElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Buscamos el input específicamente por su ID dentro del formulario
    const emailInput = document.querySelector(
      '#email-input'
    ) as HTMLInputElement;

    if (emailInput) {
      const email = emailInput.value;

      const { error } = await supabase
        .from('leads')
        .insert([{ email: email, municipality: 'Viotá' }]);

      if (error) {
        (window as any).showModal('error', 'Error al registrarte', error.message);
      } else {
        (window as any).showModal('success', '¡Registro exitoso!', 'Gracias por unirte a Munitrip. Te avisaremos cuando lancemos.');
        form.reset();
      }
    } else {
      console.error("No se encontró el input con id 'email-input'");
    }
  });
</script>
