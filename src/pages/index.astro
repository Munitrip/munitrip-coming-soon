      </section>

      <!-- SECCIÓN PARA DUEÑOS DE NEGOCIO (Business Section) -->
      <section
        class="px-6 py-8 bg-gradient-to-b from-brand-dark/5 to-transparent flex flex-col items-center border-t-2 border-border-light text-center"
      >
        <h3 class="text-brand-dark font-bold text-lg mb-2">
          ¿Tienes un negocio?
        </h3>
        <p
          class="text-[12px] text-text-paragraph leading-5 mb-6 font-medium max-w-[330px]"
        >
          Únete a nuestra red de socios y lleva tu negocio a más turistas y
          visitantes
        </p>
        <a
          href="https://wa.me/573227410781?text=Hola,%20quiero%20ser%20socio%20fundador%20de%20Munitrip"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-brand-dark text-white px-6 py-2.5 rounded-full text-[13px] font-medium hover:bg-brand-dark-hover transition-colors shadow-sm"
        >
          Sé un socio
        </a>
      </section>
      <!-- Footer (Estilo Corporativo Munitrip) -->
      <footer class="bg-brand-dark text-white py-8 px-6">
        <div class="flex flex-col gap-6">
          <!-- Contacto -->
          <div class="flex flex-col items-center gap-2">
            <p class="text-[12px] font-semibold text-white/80">Contáctanos</p>
            <a
              href="mailto:contacto@munitrip.com"
              class="text-[13px] font-medium hover:text-brand-light transition-colors"
            >
