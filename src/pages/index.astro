---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import hero1 from '../assets/hero-1.webp';
import hero2 from '../assets/hero-2.webp';
import hero3 from '../assets/hero-3-1.webp';
import hero4 from '../assets/hero-4.webp';
import hero4Profile from '../assets/hero-4-1.webp';
import icono from '../assets/munitrip-favicon.webp';

import Header from '../components/Header.astro';
import Modal from '../components/Modal.astro';
import SegmentContainer from '../components/SegmentContainer.astro';
import Segment1 from '../components/segment-carrucel/Segment1.astro';
import Segment2 from '../components/segment-carrucel/Segment2.astro';
import Segment3 from '../components/segment-carrucel/Segment3.astro';
import Segment4 from '../components/segment-carrucel/Segment4.astro';
import Segment5 from '../components/segment-carrucel/SegmentMotivational.astro';
---

<Layout title="Munitrip | Próximamente">
  <!-- 1. Fondo global del body -->
  <main
    class="min-h-screen bg-bg-general font-inter flex flex-col items-center"
  >
    <!-- 2. Contenedor "Mobile-First" centrado con bordes laterales -->
    <div
      class="w-full max-w-md bg-bg-card min-h-screen flex flex-col relative shadow-2xl border-x border-border-light"
    >
      <Header activePage="inicio" />

      <div class="text-center bg-bg-card pt-4 pb-2 px-6">
        <h1
          class="text-brand-dark font-extrabold text-3xl tracking-tight leading-none"
        >
          ¡Próximamente!
        </h1>
        <h2 class="text-text-paragraph font-medium text-lg mt-1">
          Algo <span class="font-bold text-brand-dark">grande</span> se está construyendo
        </h2>
      </div>

      <!-- Banner Informativo (Contraste Oscuro) -->
      <div
        class="bg-brand-dark text-white shadow-sm text-center py-1.5 px-13 text-[11px] font-light w-full rounded-lg"
      >
        <p class="leading-4">
          La plataforma que conecta turistas y habitantes con lo mejor de <span
            class="font-bold">Viotá, Cundinamarca</span
          >.
        </p>
      </div>

      <!-- ESPACIO PARA SEGMENTOS FLEXIBLES -->
      <section class="bg-bg-card w-full overflow-hidden">
        <SegmentContainer>
          <!-- Contenedor de desplazamiento con altura controlada -->

          <Segment1 hero1={hero1} />
          <Segment4
            hero4={hero4}
            hero4Profile={hero4Profile}
            icono={icono}
          />
          <Segment2 hero2={hero2} />
          <Segment3 hero3={hero3} />
          <Segment5 />
        </SegmentContainer>
      </section>

      <!-- FORMULARIO DE CONTACTO (White Section) -->
      <section
        class="px-6 py-5 bg-bg-card flex flex-col items-center border-t-2 border-border-light text-center"
      >
        <p
          class="text-[11px] text-text-paragraph leading-4 mb-3 font-medium max-w-[330px]"
        >
          Estamos preparando la mejor experiencia para que encuentres los
          lugares, alojamientos y restaurantes perfectos <br />
        </p>

        <div class="w-20 h-[3px] rounded-full mb-6 bg-brand-dark"></div>

        <p class="text-[13px] text-brand-dark-muted font-semibold mb-6">
          Déjanos tu correo y sé el primero en enterarte.
        </p>

        <!-- Formulario Pill sin espacios internos -->
        <form
          id="newsletter-form"
          class="w-full max-w-[400px] flex bg-bg-general border border-border-light rounded-full overflow-hidden shadow-sm"
        >
          <div class="flex items-center flex-1 pl-5">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="opacity-80 text-text-secondary"
            >
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>

            <input
              id="email-input"
              type="email"
              placeholder="Tu correo electrónico"
              required
              class="w-full bg-transparent px-3 py-2 text-[13px] outline-none text-text-title placeholder:text-text-secondary/60"
            />
          </div>

          <button
            type="submit"
            class="bg-brand-dark rounded-full text-white px-9 py-3 text-[13px] font-medium hover:bg-brand-dark-hover transition-colors"
          >
            Notificarme
          </button>
        </form>

        <!-- Sección de Redes Sociales -->
        <div class="w-full mt-12 flex flex-col items-center">
          <button
            id="openSocialModal"
            class="text-[13px] text-brand-dark font-semibold mb-6 hover:opacity-70 transition-opacity cursor-pointer"
          >
            Síguenos en nuestras redes sociales
          </button>

          <!-- Iconos de Redes Sociales -->
          <div class="flex gap-8 justify-center">
            <!-- Facebook -->
            <a
              href="https://www.facebook.com/share/1BAB49K6F8"
              target="_blank"
              class="hover:scale-110 transition-transform"
              title="Facebook"
            >
              <svg
