---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalURL?: string;
  noIndex?: boolean;
  jsonLd?: Record<string, unknown>[];
  breadcrumbs?: { name: string; url: string }[];
  geo?: { lat: string; lng: string; region: string; place: string };
  googleVerification?: string;
  keywords?: string;
}

const {
  title,
  description = 'Munitrip es la plataforma que conecta turistas y habitantes con lo mejor de Viotá, Cundinamarca, y cada municipio de Colombia. Alojamientos, restaurantes, experiencias y más en un solo lugar.',
  ogImage = '/og-image.png',
  ogType = 'website',
  canonicalURL = 'https://munitrip.com/',
  noIndex = false,
  jsonLd = [],
  breadcrumbs = [],
  geo = { lat: '4.4376', lng: '-74.4754', region: 'CO-CUN', place: 'Viotá, Cundinamarca' },
  googleVerification,
  keywords = 'turismo Colombia, municipios Colombia, turismo local, Viotá, Cundinamarca, hoteles en Viotá, restaurantes en Viotá, alojamientos rurales Cundinamarca, guía turística Colombia, hospedajes Viotá, ecoturismo Cundinamarca, qué hacer en Viotá, turismo municipal Colombia, destinos Colombia, viajes Colombia, naturaleza Cundinamarca, gastronomía Viotá, Monte La MaMa, Centro Histórico Viotá, planes en Viotá, turismo de naturaleza',
} = Astro.props;

const siteUrl = 'https://munitrip.com';
const pageTitle = title.includes('Munitrip') ? title : `${title} | Munitrip`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---

<!doctype html>
<html lang="es" prefix="og: https://ogp.me/ns#">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#1d3557" />
		<meta name="application-name" content="Munitrip" />
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		<meta name="format-detection" content="telephone=yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="Munitrip" />

		{/* Title & Description */}
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow'} />
		<meta name="language" content="es" />
		<meta name="author" content="Munitrip" />
		<meta name="keywords" content={keywords} />
		{geo && <>
			<meta name="geo.position" content={`${geo.lat};${geo.lng}`} />
			<meta name="geo.region" content={geo.region} />
			<meta name="geo.placename" content={geo.place} />
			<meta name="ICBM" content={`${geo.lat}, ${geo.lng}`} />
		</>}
		{googleVerification && <meta name="google-site-verification" content={googleVerification} />}

		{/* Canonical */}
		<link rel="canonical" href={canonicalURL} />

		{/* Icons */}
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/favicon.ico" />
		<meta name="msapplication-TileColor" content="#1d3557" />

		{/* Open Graph */}
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:secure_url" content={ogImageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Munitrip" />
		<meta property="og:locale" content="es_CO" />

		{/* Twitter Card */}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@Munitrip_co" />
		<meta name="twitter:creator" content="@Munitrip_co" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={description} />
		<meta property="og:image:alt" content={description} />

		{/* Inter font self-hosted (see global.css @font-face) */}
		<link rel="preload" href="/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin />

		{/* JSON-LD Structured Data */}
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": ["Organization", "TouristInformationCenter"],
					"@id": `${siteUrl}/#organization`,
					"name": "Munitrip",
					"url": siteUrl,
					"logo": {
						"@type": "ImageObject",
						"url": `${siteUrl}/og-image.png`,
						"width": 1200,
						"height": 630
					},
					"slogan": "Tu guía de turismo local para los municipios de Colombia",
					"description": "Plataforma que conecta turistas y habitantes con lo mejor de Viotá, Cundinamarca, y cada municipio de Colombia.",
					"address": {
						"@type": "PostalAddress",
						"addressLocality": "Viotá",
						"addressRegion": "Cundinamarca",
						"addressCountry": "CO"
					},
					"geo": {
						"@type": "GeoCoordinates",
						"latitude": geo.lat,
						"longitude": geo.lng
					},
					"foundingDate": "2026",
					"foundingLocation": {
						"@type": "Place",
						"name": "Viotá, Cundinamarca, Colombia"
					},
					"knowsAbout": ["Turismo local", "Turismo municipal", "Guía turística", "Alojamientos", "Restaurantes", "Experiencias turísticas"],
					"sameAs": [
						"https://www.facebook.com/share/1BAB49K6F8",
						"https://www.instagram.com/munitrip.co",
						"https://www.tiktok.com/@munitrip.com",
						"https://x.com/Munitrip_co",
						"https://www.linkedin.com/company/munitrip",
						"https://www.youtube.com/@Munitrip"
					]
				},
				{
					"@type": "WebSite",
					"@id": `${siteUrl}/#website`,
					"url": siteUrl,
					"name": "Munitrip",
					"description": "Tu guía de turismo local para Viotá, Cundinamarca, y cada municipio de Colombia.",
					"publisher": { "@id": `${siteUrl}/#organization` },
					"inLanguage": "es-CO",
					"potentialAction": {
						"@type": "SearchAction",
						"target": {
							"@type": "EntryPoint",
							"urlTemplate": `${siteUrl}/search?q={search_term_string}`
						},
						"query-input": "required name=search_term_string"
					}
				},
				{
					"@type": ["WebPage", "ItemPage"],
					"@id": `${canonicalURL}#webpage`,
					"url": canonicalURL,
					"name": pageTitle,
					"description": description,
					"keywords": keywords,
					"isPartOf": { "@id": `${siteUrl}/#website` },
					"about": { "@id": `${siteUrl}/#organization` },
					"mainEntity": { "@id": `${siteUrl}/#organization` },
					"inLanguage": "es-CO",
					"datePublished": "2026-01-01",
					"dateModified": new Date().toISOString().split('T')[0],
					...(breadcrumbs.length > 0 ? { "breadcrumb": { "@id": `${canonicalURL}#breadcrumb` } } : {}),
					"primaryImageOfPage": {
						"@type": "ImageObject",
						"url": ogImageUrl,
						"width": 1200,
						"height": 630
					}
				},
				{
					"@type": "LocalBusiness",
					"@id": `${siteUrl}/#localbusiness`,
					"name": "Munitrip",
					"description": "Plataforma de turismo local para Viotá, Cundinamarca, y cada municipio de Colombia.",
					"url": siteUrl,
					"parentOrganization": { "@id": `${siteUrl}/#organization` },
					"address": {
						"@type": "PostalAddress",
						"addressLocality": "Viotá",
						"addressRegion": "Cundinamarca",
						"addressCountry": "CO"
					},
					"geo": {
						"@type": "GeoCoordinates",
						"latitude": geo.lat,
						"longitude": geo.lng
					},
					"areaServed": [
						{ "@type": "City", "name": "Viotá" },
						{ "@type": "State", "name": "Cundinamarca" },
						{ "@type": "Country", "name": "Colombia" }
					],
					"priceRange": "$$"
				},
				...(breadcrumbs.length > 0 ? [{
					"@type": "BreadcrumbList",
					"@id": `${canonicalURL}#breadcrumb`,
					"itemListElement": breadcrumbs.map((b, i) => ({
						"@type": "ListItem",
						"position": i + 1,
						"name": b.name,
						"item": b.url
					}))
				}] : []),
				...jsonLd
			]
		})} />
	</head>
	<body itemscope itemtype="https://schema.org/WebPage">
		<meta itemprop="name" content={pageTitle} />
		<meta itemprop="description" content={description} />
		<link itemprop="url" href={canonicalURL} />
		<meta itemprop="inLanguage" content="es-CO" />
		<meta itemprop="primaryImageOfPage" content={ogImageUrl} />
		<slot />
	</body>
</html>