---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	ogType?: string;
	canonicalURL?: string;
	noIndex?: boolean;
	jsonLd?: Record<string, unknown>[];
}

const {
	title,
	description = 'Munitrip es la plataforma que conecta turistas y habitantes con lo mejor de Viotá, Cundinamarca, y cada municipio de Colombia. Alojamientos, restaurantes, experiencias y más en un solo lugar.',
	ogImage = '/og-image.png',
	ogType = 'website',
	canonicalURL = 'https://munitrip.com/',
	noIndex = false,
	jsonLd = [],
} = Astro.props;

const siteUrl = 'https://munitrip.com';
const pageTitle = title.includes('Munitrip') ? title : `${title} | Munitrip`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---

<!doctype html>
<html lang="es" prefix="og: https://ogp.me/ns#">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#1d3557" />
		<meta name="application-name" content="Munitrip" />
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		<meta name="format-detection" content="telephone=yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="Munitrip" />

		{/* Title & Description */}
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow'} />
		<meta name="language" content="es" />
		<meta name="author" content="Munitrip" />

		{/* Canonical */}
		<link rel="canonical" href={canonicalURL} />

		{/* Icons */}
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/favicon.ico" />
		<meta name="msapplication-TileColor" content="#1d3557" />

		{/* Open Graph */}
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Munitrip" />
		<meta property="og:locale" content="es_CO" />

		{/* Twitter Card */}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@Munitrip_co" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={description} />
		<meta property="og:image:alt" content={description} />

		{/* Google Fonts: Inter */}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet" />

		{/* JSON-LD Structured Data */}
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "Organization",
					"@id": `${siteUrl}/#organization`,
					"name": "Munitrip",
					"url": siteUrl,
					"logo": `${siteUrl}/og-image.png`,
					"description": "Plataforma que conecta turistas y habitantes con lo mejor de Viotá, Cundinamarca, y cada municipio de Colombia.",
					"address": {
						"@type": "PostalAddress",
						"addressLocality": "Viotá",
						"addressRegion": "Cundinamarca",
						"addressCountry": "CO"
					},
					"sameAs": [
						"https://www.facebook.com/share/1BAB49K6F8",
						"https://www.instagram.com/munitrip.co",
						"https://www.tiktok.com/@munitrip.com",
						"https://x.com/Munitrip_co",
						"https://www.linkedin.com/company/munitrip",
						"https://www.youtube.com/@Munitrip"
					]
				},
				{
					"@type": "WebSite",
					"@id": `${siteUrl}/#website`,
					"url": siteUrl,
					"name": "Munitrip",
					"description": "Tu guía de turismo local para Viotá, Cundinamarca, y cada municipio de Colombia.",
					"publisher": { "@id": `${siteUrl}/#organization` },
					"inLanguage": "es-CO",
					"potentialAction": {
						"@type": "SearchAction",
						"target": {
							"@type": "EntryPoint",
							"urlTemplate": `${siteUrl}/search?q={search_term_string}`
						},
						"query-input": "required name=search_term_string"
					}
				},
				{
					"@type": ["WebPage", "ItemPage"],
					"@id": `${canonicalURL}#webpage`,
					"url": canonicalURL,
					"name": pageTitle,
					"description": description,
					"isPartOf": { "@id": `${siteUrl}/#website` },
					"about": { "@id": `${siteUrl}/#organization` },
					"inLanguage": "es-CO",
					"datePublished": "2026-01-01",
					"dateModified": "2026-05-11"
				},
				{
					"@type": "LocalBusiness",
					"@id": `${siteUrl}/#localbusiness`,
					"name": "Munitrip",
					"description": "Plataforma de turismo local para Viotá, Cundinamarca, y cada municipio de Colombia.",
					"url": siteUrl,
					"address": {
						"@type": "PostalAddress",
						"addressLocality": "Viotá",
						"addressRegion": "Cundinamarca",
						"addressCountry": "CO"
					},
					"areaServed": ["Viotá", "Cundinamarca", "Colombia"],
					"priceRange": "$$"
				},
				...jsonLd
			]
		})} />
	</head>
	<body>
		<slot />
	</body>
</html>