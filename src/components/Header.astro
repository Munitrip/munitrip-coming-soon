---
import { Image } from 'astro:assets';
import logoMunitrip from '../assets/logo.webp';

interface Props {
  activePage?: 'inicio' | 'como-funciona' | 'viota-turismo' | 'para-negocios' | 'contacto';
}

const { activePage } = Astro.props;

const navLinks = [
  { href: '/', label: 'Inicio', id: 'inicio' as const },
  { href: '/como-funciona', label: 'Cómo funciona', id: 'como-funciona' as const },
  { href: '/viota-turismo', label: 'Viotá Turismo', id: 'viota-turismo' as const },
  { href: '/para-negocios', label: 'Para negocios', id: 'para-negocios' as const },
  { href: '/contacto', label: 'Contacto', id: 'contacto' as const },
];
---

<header class="pt-6 pb-1 md:pt-8 md:pb-2 flex flex-col items-center bg-bg-card">
  <a href="/" aria-label="Munitrip - Ir al inicio" class="flex flex-col items-center">
    <div class="h-16 md:h-20 lg:h-20 flex items-center justify-center">
      <Image
        src={logoMunitrip}
        alt="Munitrip - Tu guía de turismo local para los municipios de Colombia"
        class="h-full w-auto max-w-[140px] md:max-w-[180px] lg:max-w-[200px] object-contain"
        width={2000}
        height={801}
        loading="eager"
        decoding="sync"
      />
    </div>
  </a>

  <nav class="w-full overflow-x-auto scrollbar-none border-b border-border-light" aria-label="Navegación principal">
    <div class="nav-container flex items-center py-3 md:py-6 lg:py-8 pl-8 pr-5 md:pl-6 md:pr-4 gap-4 md:gap-2 lg:gap-3 xl:gap-4 2xl:gap-8 w-max min-w-full md:min-w-0 md:mx-auto">
      {navLinks.map((link) => {
        const isActive = activePage === link.id;
        return (
          <a
            href={link.href}
            aria-current={isActive ? 'page' : undefined}
            class={`shrink-0 transition-colors whitespace-nowrap py-1 ${
              isActive
                ? 'text-text-title border-b-2 border-text-title'
                : 'text-text-secondary hover:text-text-title'
            }`}
          >
            <span class="text-xs lg:text-sm xl:text-base font-bold">{link.label}</span>
          </a>
        );
      })}
    </div>
  </nav>
</header>

<style>
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .nav-container {
    flex-wrap: nowrap;
  }
</style>
