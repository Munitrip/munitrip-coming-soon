---
import { Image } from 'astro:assets';

interface Props {
  hero2: ImageMetadata;
}

const { hero2 } = Astro.props;
---

<div
  class="w-full box-border scrollbar-none snap-center bg-bg-card shrink-0 flex flex-col overflow-hidden"
>
  <div
    class="w-full flex flex-col items-center text-center px-1 py-5 md:py-7 lg:py-8"
  >
    <h2 class="text-text-title font-extrabold text-xl md:text-2xl lg:text-3xl leading-tight">
      Tu próximo viaje empieza aquí
    </h2>
    <h3 class="text-text-secondary font-extrabold text-base md:text-lg -mb-1.5">
      ¿Qué hacer en Viotá, Cundinamarca?
    </h3>
  </div>

  <div class="w-full h-44 md:h-52 lg:h-60 bg-gray-200 overflow-hidden relative">
    <Image src={hero2} alt="Monte La MaMa - Refugio en el corazón del bosque, Viotá Cundinamarca" class="w-full h-full object-cover" width={800} height={360} sizes="(max-width: 768px) 100vw, 600px" widths={[400, 600, 800]} loading="lazy" decoding="async" />
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"
    >
    </div>
    <div class="absolute bottom-4 left-4 text-white text-left">
      <h2 class="text-lg md:text-xl lg:text-2xl font-extrabold leading-tight text-white">
        Monte La MaMa:
      </h2>
      <p class="text-xs md:text-sm lg:text-base font-medium opacity-90 text-white">
        Refugio en el corazón del bosque
      </p>
    </div>
  </div>

  <!-- Navegación de Categorías: no-scrollbar y flex-nowrap evitan que se rompa el contenedor -->
  <div
    class="flex justify-center scrollbar-none overflow-x-auto py-5 md:py-6 lg:py-8 px-4 gap-5 md:gap-6 lg:gap-8 items-center bg-bg-card w-full"
  >
    <div class="flex items-center gap-2 text-text-secondary shrink-0">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        id="Outline"
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="currentColor"
        class="w-5 h-5 md:w-6 md:h-6"
        ><path
          d="M23.121,9.069,15.536,1.483a5.008,5.008,0,0,0-7.072,0L.879,9.069A2.978,2.978,0,0,0,0,11.19v9.817a3,3,0,0,0,3,3H21a3,3,0,0,0,3-3V11.19A2.978,2.978,0,0,0,23.121,9.069ZM15,22.007H9V18.073a3,3,0,0,1,6,0Zm7-1a1,1,0,0,1-1,1H17V18.073a5,5,0,0,0-10,0v3.934H3a1,1,0,0,1-1-1V11.19a1.008,1.008,0,0,1,.293-.707L9.878,2.9a3.008,3.008,0,0,1,4.244,0l7.585,7.586A1.008,1.008,0,0,1,22,11.19Z"
        ></path></svg
      >
      <span class="text-xs md:text-sm lg:text-base font-bold">Todo</span>
    </div>

    <div
      class="flex items-center gap-2 text-text-title shrink-0 border-b-2 border-text-title pb-1"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        id="Layer_1"
        data-name="Layer 1"
        viewBox="0 0 24 24"
        width="24"
        height="24"
