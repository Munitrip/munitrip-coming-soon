---
import { Image } from 'astro:assets';

interface Props {
  hero1: ImageMetadata;
}

const { hero1 } = Astro.props;
---

<div class="min-w-full snap-center bg-bg-card shrink-0 flex flex-col">
  <div
    class="w-full flex flex-col items-center text-center px-1 py-5 md:py-7 lg:py-8"
  >
    <h2
      class="text-text-title font-extrabold text-xl md:text-2xl lg:text-3xl leading-tight"
    >
      Planifica, visita, descubre
    </h2>
    <h3
      class="text-text-secondary font-extrabold text-base md:text-lg leading-tight"
    >
      Encuentra todo en un solo lugar
    </h3>
  </div>

  <div class="relative w-full h-44 md:h-52 lg:h-60 bg-gray-200 overflow-hidden">
    <Image
      src={hero1}
      alt="Atardecer en Viotá, Cundinamarca - paisaje colombiano"
      class="w-full h-full object-cover"
      width={1200}
      height={754}
      sizes="(max-width: 768px) 100vw, 600px"
      widths={[400, 600, 900, 1200]}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>

  <div class="grid grid-cols-5 w-full py-4 md:py-6 lg:py-8 px-1 bg-bg-card">
    <div class="flex flex-col items-center justify-center w-full gap-1.5">
      <svg
