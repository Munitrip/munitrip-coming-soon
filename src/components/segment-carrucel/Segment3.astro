---
import { Image } from 'astro:assets';

interface Props {
  hero3: ImageMetadata;
}

const { hero3 } = Astro.props;
---

<div
  class="min-w-full snap-center shadow-lg shadow-black/20 bg-bg-card shrink-0 flex flex-col overflow-hidden backface-hidden transform-gpu"
  style="image-rendering: -webkit-optimize-contrast; -webkit-font-smoothing: antialiased;"
>
  <div
    class="w-full flex flex-col items-center text-center px-1 py-5 md:py-7 lg:py-8 border-b-2 border-border-light"
  >
    <h2
      class="text-text-title font-extrabold text-xl md:text-2xl lg:text-3xl leading-tight antialiased"
    >
      Encuentra tu lugar ideal
    </h2>
    <h3
      class="text-text-secondary font-extrabold text-base md:text-lg antialiased"
    >
      Los mejores restaurantes en Viotá
    </h3>
  </div>

  <div class="w-full h-full bg-bg-general flex items-center justify-center p-2 md:p-3">
    <div
      class="w-full max-w-[320px] sm:max-w-sm md:max-w-md shadow-lg shadow-black/20 bg-bg-card border-2 border-border-light rounded-4xl p-3 md:p-4 flex gap-4 md:gap-5 transform-gpu"
    >
      <div class="w-[40%] aspect-[2/3] h-auto overflow-hidden rounded-2xl shrink-0">
        <Image
          src={hero3}
          alt="Restaurante destacado en Viotá, Cundinamarca - gastronomía local colombiana"
          class="w-full h-full object-cover"
          width={300}
          height={450}
          sizes="200px"
          widths={[200, 300, 400]}
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="w-[60%] flex flex-col pr-1 py-1">
        <div class="antialiased space-y-1">
          <div class="flex items-center justify-end gap-1">
            <svg
              class="w-3 h-3 md:w-3.5 text-tag-green"
              fill="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="m23.195,14.085l-2.159,2.157v1.722c0,1.654-1.346,3-3,3h-1.721l-2.158,2.157c-.565.566-1.319.879-2.121.879s-1.555-.312-2.121-.879l-2.157-2.157h-1.722c-1.654,0-3-1.346-3-3v-1.722l-2.157-2.157c-1.17-1.169-1.17-3.073,0-4.243l2.157-2.157v-1.721c0-1.654,1.346-3,3-3h1.722l2.157-2.158c1.134-1.135,3.111-1.132,4.243,0l2.157,2.157h1.721c.553,0,1,.448,1,1s-.447,1-1,1h-2.135c-.266,0-.52-.105-.707-.293l-2.451-2.451c-.377-.376-1.034-.378-1.414,0l-2.45,2.451c-.188.188-.441.293-.707.293h-2.136c-.552,0-1,.449-1,1v2.135c0,.265-.105.52-.293.707l-2.45,2.45c-.39.39-.39,1.024,0,1.415l2.45,2.45c.188.188.293.441.293.707v2.136c0,.552.448,1,1,1h2.136c.266,0,.52.105.707.293l2.45,2.45c.379.378,1.037.378,1.413,0l2.452-2.45c.188-.188.441-.293.707-.293h2.135c.552,0,1-.448,1-1v-2.136c0-.266.105-.52.293-.707l2.451-2.45c.39-.39.39-1.025,0-1.415-.39-.391-.39-1.024,0-1.414.391-.39,1.024-.391,1.415,0,1.168,1.169,1.168,3.072,0,4.242Zm-12.474-.423l-3.018-2.988c-.394-.39-1.025-.385-1.415.007-.389.392-.385,1.025.007,1.414l3.019,2.989c.614.608,1.422.913,2.229.913s1.617-.307,2.232-.918l8.93-8.871c.392-.389.394-1.022.004-1.414-.39-.392-1.022-.395-1.414-.005l-8.93,8.872c-.453.451-1.19.45-1.644,0Z"
              ></path>
            </svg>
            <span class="text-tag-green text-[11px] md:text-xs font-bold">Verificado</span>
          </div>

          <span class="text-text-secondary text-[11px] md:text-xs font-bold block"
            >Restaurante</span
          >

          <h3 class="text-text-title text-base md:text-lg lg:text-xl font-bold leading-tight">
            Gastro Bar La Madriguera
          </h3>
          <div class="w-12 h-0.5 bg-text-title"></div>

          <div class="flex items-center gap-1 text-[11px] md:text-xs">
            <span class="font-bold text-text-title">( 4.4 )</span>
            <span class="text-text-title text-sm">★★★★ </span>
            <span class="text-text-secondary font-bold text-[11px] md:text-xs">
              - 120</span
            >
          </div>

          <div class="">
            <p
              class="text-text-paragraph text-justify text-[11px] md:text-xs leading-4 font-semibold"
            >
              Un restaurante que ofrece comida deliciosa y variada. Decoración
              acogedora y un ambiente familiar.
            </p>
          </div>
        </div>

        <div class="flex flex-wrap justify-center gap-1.5 mt-2">
          <span
            class="bg-brand-dark text-white text-[11px] md:text-xs px-3 py-px rounded-lg font-light"
            >Parrilla</span
          >
          <span
            class="bg-brand-dark text-white text-[11px] md:text-xs px-3 py-px rounded-lg font-light"
            >Bebidas</span
          >
        </div>
      </div>
    </div>
  </div>
</div>
