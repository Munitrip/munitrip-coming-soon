---
// Segment1.astro
import { Image } from 'astro:assets';

interface Props {
  hero3: ImageMetadata; // Solo pasamos la imagen como prop
}

const { hero3 } = Astro.props;
---

<!-- SEGMENTO 3: Mantiene el tamaño exacto de los anteriores -->
<div
  class="min-w-full snap-center shadow-lg shadow-black/20 bg-bg-card shrink-0 flex flex-col overflow-hidden backface-hidden transform-gpu"
  style="image-rendering: -webkit-optimize-contrast; -webkit-font-smoothing: antialiased;"
>
  <div
    class="w-full flex flex-col items-center = text-center px-1 py-7 md:py-9 lg:py-11 xl:py-14 2xl:py-16 border-b-2 border-border-light"
  >
    <h2
      class="text-text-title font-extrabold text-[22px] md:text-2xl lg:text-3xl xl:text-4xl 2xl:text-5xl leading-tight antialiased"
    >
      Encuentra tu lugar ideal
    </h2>
    <h3
      class="text-text-secondary font-extrabold text-[16px] md:text-xl lg:text-2xl xl:text-3xl 2xl:text-4xl -mb-1.5 antialiased"
    >
      Los mejores restaurantes en Viotá
    </h3>
  </div>

  <div class="w-full h-full bg-bg-general flex items-center justify-center p-1">
    <div
      class="w-full max-w-[360px] md:max-w-md lg:max-w-lg xl:max-w-xl 2xl:max-w-2xl shadow-lg shadow-black/20 bg-bg-card border-2 border-border-light rounded-4xl p-2 md:p-3 lg:p-4 xl:p-5 2xl:p-6 flex gap-4 xl:gap-6 2xl:gap-8 transform-gpu"
    >
      <div class="w-[45%] h-57 md:h-64 lg:h-72 xl:h-80 2xl:h-96 overflow-hidden rounded-3xl shrink-0">
        <Image
          src={hero3}
          alt="Gastro Bar La Madriguera - restaurante en Viotá, Cundinamarca con comida parrilla y ambiente familiar"
          class="w-full h-full object-cover"
        />
      </div>

      <div class="w-[55%] flex flex-col justify-between pr-2 md:pr-3 lg:pr-4 py-1">
        <div class="antialiased">
          <div class="flex items-center justify-end gap-1 pb-1 mt-1 mr-1">
            <svg
              class="w-3.5 h-3.5 md:w-4 md:h-4 xl:w-5 xl:h-5 text-tag-green"
              fill="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="m23.195,14.085l-2.159,2.157v1.722c0,1.654-1.346,3-3,3h-1.721l-2.158,2.157c-.565.566-1.319.879-2.121.879s-1.555-.312-2.121-.879l-2.157-2.157h-1.722c-1.654,0-3-1.346-3-3v-1.722l-2.157-2.157c-1.17-1.169-1.17-3.073,0-4.243l2.157-2.157v-1.721c0-1.654,1.346-3,3-3h1.722l2.157-2.158c1.134-1.135,3.111-1.132,4.243,0l2.157,2.157h1.721c.553,0,1,.448,1,1s-.447,1-1,1h-2.135c-.266,0-.52-.105-.707-.293l-2.451-2.451c-.377-.376-1.034-.378-1.414,0l-2.45,2.451c-.188.188-.441.293-.707.293h-2.136c-.552,0-1,.449-1,1v2.135c0,.265-.105.52-.293.707l-2.45,2.45c-.39.39-.39,1.024,0,1.415l2.45,2.45c.188.188.293.441.293.707v2.136c0,.552.448,1,1,1h2.136c.266,0,.52.105.707.293l2.45,2.45c.379.378,1.037.378,1.413,0l2.452-2.45c.188-.188.441-.293.707-.293h2.135c.552,0,1-.448,1-1v-2.136c0-.266.105-.52.293-.707l2.451-2.45c.39-.39.39-1.025,0-1.415-.39-.391-.39-1.024,0-1.414.391-.39,1.024-.391,1.415,0,1.168,1.169,1.168,3.072,0,4.242Zm-12.474-.423l-3.018-2.988c-.394-.39-1.025-.385-1.415.007-.389.392-.385,1.025.007,1.414l3.019,2.989c.614.608,1.422.913,2.229.913s1.617-.307,2.232-.918l8.93-8.871c.392-.389.394-1.022.004-1.414-.39-.392-1.022-.395-1.414-.005l-8.93,8.872c-.453.451-1.19.45-1.644,0Z"
              ></path>
            </svg>
            <span class="text-tag-green text-[11px] md:text-xs xl:text-sm font-bold">Verificado</span>
          </div>

          <span class="text-text-secondary text-[11px] md:text-xs xl:text-sm font-bold block mb-1"
            >Restaurante</span
          >

          <h3 class="text-text-title text-[18px] md:text-xl lg:text-2xl xl:text-3xl 2xl:text-4xl font-bold leading-tight">
            Gastro Bar La Madriguera
          </h3>
          <div class="w-16 h-0.5 bg-text-title mt-1.5 mb-1 md:mt-2 md:mb-1.5"></div>

          <div class="flex items-center gap-1 text-[12px] md:text-sm xl:text-base">
            <span class="font-bold text-text-title">( 4.4 )</span>
            <span class="text-text-title text-[15px] md:text-lg xl:text-xl">★★★★ </span>
            <span class="text-text-secondary font-bold text-[11px] md:text-xs xl:text-sm">
              - 120</span
            >
          </div>

          <div class="">
            <p
              class="text-text-paragraph text-justify text-[11px] md:text-xs xl:text-sm leading-4 md:leading-5 xl:leading-6 font-semibold mt-2 md:mt-3"
            >
              Un restaurante que ofrece comida deliciosa y variada. Decoración
              acogedora y un ambiente familiar.
            </p>
          </div>
        </div>

        <div class="flex flex-wrap justify-center gap-1.5 md:gap-2 xl:gap-3 mt-3 md:mt-4 mb-2">
          <span
            class="bg-brand-dark text-white text-[11px] md:text-xs xl:text-sm 2xl:text-base px-4 py-px rounded-lg font-light"
            >Parrilla</span
          >
          <span
            class="bg-brand-dark text-white text-[11px] md:text-xs xl:text-sm 2xl:text-base px-4 py-px rounded-lg font-light"
            >Bebidas</span
          >
        </div>
      </div>
    </div>
  </div>
</div>
