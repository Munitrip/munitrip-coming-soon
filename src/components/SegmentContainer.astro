---
interface Props {
  segmentCount?: number;
}

const { segmentCount = 5 } = Astro.props;
---

<div class="w-full bg-bg-general pt-8 md:pt-10 lg:pt-12">
  <div
    id="carousel-container"
    class="flex border-t-2 border-b-2 border-border-light shadow-sm overflow-x-auto snap-x snap-mandatory rounded-3xl no-scrollbar"
  >
    <slot />
  </div>

  <!-- renderizados en servidor para evitar CLS -->
  <div id="dots-container" class="flex justify-center gap-3 py-3">
    {
      Array.from({ length: segmentCount }, (_, i) => (
        <div
          class="dot w-3 h-3 rounded-full bg-border-light transition-all duration-300"
          style="cursor:pointer"
          data-index={i}
        />
      ))
    }
  </div>
</div>

<style>
  /* Ocultar barra de scroll */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  const initCarousel = () => {
    const container = document.getElementById(
      'carousel-container'
    ) as HTMLDivElement | null;
    const dotsContainer = document.getElementById(
      'dots-container'
    ) as HTMLDivElement | null;

    if (!container || !dotsContainer) return;

    const segmentCount = container.children.length;
    let autoScrollInterval: ReturnType<typeof setInterval> | null = null;
    let isAutoScrolling = true;

    // Dots already server-rendered — just select them
    const dots = dotsContainer.querySelectorAll(
      '.dot'
    ) as NodeListOf<HTMLDivElement>;

    const loadSlideImages = (index: number): void => {
      for (let i = Math.max(0, index - 1); i <= Math.min(segmentCount - 1, index + 1); i++) {
        const slide = container.children[i] as HTMLElement;
        const imgs = slide.querySelectorAll<HTMLImageElement>('img[loading="lazy"]');
        imgs.forEach((img) => {
          if (img.dataset.lazyLoaded) return;
          img.loading = 'eager';
          img.dataset.lazyLoaded = 'true';
        });
      }
    };

    const updateDots = (): void => {
      const scrollPos = container.scrollLeft;
      const width = container.clientWidth;
      const index = Math.round(scrollPos / width);

      dots.forEach((dot, i) => {
        if (i === index) {
          dot.style.backgroundColor = 'rgb(28, 35, 58)';
          dot.style.transform = 'scale(1.1)';
        } else {
          dot.style.backgroundColor = 'rgb(209, 219, 232)';
          dot.style.transform = 'scale(1)';
        }
      });

      loadSlideImages(index);
    };

    const getCurrentIndex = (): number => {
      const scrollPos = container.scrollLeft;
      const width = container.clientWidth;
      return Math.round(scrollPos / width);
    };

    const scrollToIndex = (index: number): void => {
      const scrollPos = index * container.clientWidth;
      container.scrollTo({
        left: scrollPos,
        behavior: 'smooth',
      });
    };

    const startAutoScroll = (): void => {
      if (autoScrollInterval) clearInterval(autoScrollInterval);

      autoScrollInterval = setInterval(() => {
        const currentIndex = getCurrentIndex();
        const nextIndex = (currentIndex + 1) % segmentCount;
        scrollToIndex(nextIndex);
      }, 4000);
    };

    const stopAutoScroll = (): void => {
      if (autoScrollInterval) {
        clearInterval(autoScrollInterval);
        autoScrollInterval = null;
      }
    };

    // Pause auto-scroll on manual scroll
    container.addEventListener('scroll', () => {
      updateDots();
      if (isAutoScrolling) {
        stopAutoScroll();
        isAutoScrolling = false;

        // Resume after inactivity
        setTimeout(() => {
          if (!isAutoScrolling) {
            isAutoScrolling = true;
            startAutoScroll();
          }
        }, 5000);
      }
    });

    // Click on dots to navigate
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        stopAutoScroll();
        isAutoScrolling = false;
        scrollToIndex(i);

        // Resume after inactivity
        setTimeout(() => {
          if (!isAutoScrolling) {
            isAutoScrolling = true;
            startAutoScroll();
          }
        }, 4000);
      });
    });

    updateDots();
    loadSlideImages(getCurrentIndex());

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      startAutoScroll();
    }
  };

  initCarousel();

  // Re-run on ViewTransitions navigation
  document.addEventListener('astro:page-load', initCarousel);
</script>
