---
// SegmentContainer.astro
---

<div class="w-full bg-bg-general pt-8">
  <!-- Contenedor del carrusel -->
  <div
    id="carousel-container"
    class="flex border-t-2 border-b-2 border-border-light shadow-sm overflow-x-auto snap-x snap-mandatory rounded-3xl no-scrollbar"
  >
    <slot />
  </div>

  <!-- Indicadores de posición (Dots) -->
  <div id="dots-container" class="flex justify-center gap-3 py-3"></div>
</div>

<style>
  /* Ocultar barra de scroll */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  // Definimos la lógica con Tipado de TypeScript
  const initCarousel = () => {
    const container = document.getElementById(
      'carousel-container'
    ) as HTMLDivElement | null;
    const dotsContainer = document.getElementById(
      'dots-container'
    ) as HTMLDivElement | null;

    if (!container || !dotsContainer) return;

    // Contar el número de segmentos (children del carousel)
    const segmentCount = container.children.length;
    let autoScrollInterval: ReturnType<typeof setInterval> | null = null;
    let isAutoScrolling = true;

    // Generar dots dinámicamente
    dotsContainer.innerHTML = '';
    for (let i = 0; i < segmentCount; i++) {
      const dot = document.createElement('div');
      dot.className =
        'dot w-3 h-3 rounded-full bg-border-light transition-all duration-300';
      dot.style.cursor = 'pointer';
      dotsContainer.appendChild(dot);
    }

    const dots = dotsContainer.querySelectorAll(
      '.dot'
    ) as NodeListOf<HTMLDivElement>;

    const updateDots = (): void => {
      // Calculamos el índice actual
      const scrollPos = container.scrollLeft;
      const width = container.clientWidth;
      const index = Math.round(scrollPos / width);

      dots.forEach((dot, i) => {
        if (i === index) {
          dot.style.backgroundColor = 'rgb(28, 35, 58)';
          dot.style.transform = 'scale(1.1)';
        } else {
          dot.style.backgroundColor = 'rgb(209, 219, 232)';
          dot.style.transform = 'scale(1)';
        }
      });
    };

    const getCurrentIndex = (): number => {
      const scrollPos = container.scrollLeft;
      const width = container.clientWidth;
      return Math.round(scrollPos / width);
    };

    const scrollToIndex = (index: number): void => {
      const scrollPos = index * container.clientWidth;
      container.scrollTo({
        left: scrollPos,
        behavior: 'smooth',
      });
    };

    const startAutoScroll = (): void => {
      if (autoScrollInterval) clearInterval(autoScrollInterval);

      autoScrollInterval = setInterval(() => {
        const currentIndex = getCurrentIndex();
        const nextIndex = (currentIndex + 1) % segmentCount;
        scrollToIndex(nextIndex);
      }, 4000); // Cambia a la siguiente card cada 5 segundos
    };

    const stopAutoScroll = (): void => {
      if (autoScrollInterval) {
        clearInterval(autoScrollInterval);
        autoScrollInterval = null;
      }
    };

    // Evento de scroll manual - pausa auto-scroll
    container.addEventListener('scroll', () => {
      updateDots();
      if (isAutoScrolling) {
        stopAutoScroll();
        isAutoScrolling = false;

        // Reanudar auto-scroll después de 8 segundos de inactividad
        setTimeout(() => {
          if (!isAutoScrolling) {
            isAutoScrolling = true;
            startAutoScroll();
          }
        }, 5000);
      }
    });

    // Click en dots para navegar
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        stopAutoScroll();
        isAutoScrolling = false;
        scrollToIndex(i);

        // Reanudar auto-scroll después de 8 segundos
        setTimeout(() => {
          if (!isAutoScrolling) {
            isAutoScrolling = true;
            startAutoScroll();
          }
        }, 4000);
      });
    });

    // Ejecutar al inicio para marcar el primer dot
    updateDots();

    // Iniciar auto-scroll
    startAutoScroll();
  };

  // Ejecutar cuando Astro hidrata el script
  initCarousel();

  // Opcional: Re-ejecutar si usas ViewTransitions
  document.addEventListener('astro:page-load', initCarousel);
</script>
